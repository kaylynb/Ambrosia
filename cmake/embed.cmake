# Writes a C++ source that holds each file as a byte array, so small assets ship inside the
# executable. The generated source defines dx::assets::<name>, a span of {name, bytes} pairs
# keyed by file name without its extension.
function(embed_files output name)
  set(entries "")
  set(arrays "")
  set(index 0)
  foreach(file ${ARGN})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(stem ${file} NAME_WE)
    string(APPEND arrays "        const unsigned char data${index}[] = { ${bytes} };\n")
    string(APPEND entries "        { \"${stem}\", std::span<const unsigned char>(data${index}) },\n")
    math(EXPR index "${index} + 1")
  endforeach()
  # An empty array is not C++, so with no files the span is empty.
  if(index EQUAL 0)
    file(WRITE ${output}.tmp
"// Generated by cmake/embed.cmake; do not edit.
#include <span>
#include <string_view>
#include <utility>

namespace dx::assets {
    std::span<const std::pair<std::string_view, std::span<const unsigned char>>> ${name}()
    {
        return {};
    }
}
")
    file(COPY_FILE ${output}.tmp ${output} ONLY_IF_DIFFERENT)
    return()
  endif()
  file(WRITE ${output}.tmp
"// Generated by cmake/embed.cmake; do not edit.
#include <span>
#include <string_view>
#include <utility>

namespace dx::assets {
    namespace {
${arrays}
        const std::pair<std::string_view, std::span<const unsigned char>> files[] = {
${entries}        };
    }

    std::span<const std::pair<std::string_view, std::span<const unsigned char>>> ${name}()
    {
        return files;
    }
}
")
  file(COPY_FILE ${output}.tmp ${output} ONLY_IF_DIFFERENT)
endfunction()
