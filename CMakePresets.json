{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_VS_GLOBALS": "UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true"
      }
    },
    {
      "name": "not-windows",
      "hidden": true,
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "Release with AddressSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SANITIZER": "asan" }
    },
    {
      "name": "tsan",
      "displayName": "Release with ThreadSanitizer (GCC and Clang only)",
      "inherits": ["base", "not-windows"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SANITIZER": "tsan" }
    },
    {
      "name": "mingw",
      "displayName": "Windows, cross-compiled with MinGW",
      "inherits": ["base", "not-windows"],
      "toolchainFile": "${sourceDir}/cmake/mingw-w64-toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "switch",
      "displayName": "Nintendo Switch homebrew (devkitA64; `x build switch` runs it in a container)",
      "inherits": ["base", "not-windows"],
      "generator": "Ninja",
      "toolchainFile": "$env{DEVKITPRO}/cmake/Switch.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SKIP_UT": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "asan", "configurePreset": "asan", "configuration": "Release" },
    { "name": "tsan", "configurePreset": "tsan", "configuration": "Release" },
    { "name": "mingw", "configurePreset": "mingw", "configuration": "Release" },
    { "name": "switch", "configurePreset": "switch", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "release", "inherits": "test-base", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "asan", "inherits": "test-base", "configurePreset": "asan", "configuration": "Release" },
    { "name": "tsan", "inherits": "test-base", "configurePreset": "tsan", "configuration": "Release" }
  ]
}
